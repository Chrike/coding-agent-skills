{
  "description": "Scoped leaf-agent return validation.",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^capability-harness:(evidence-researcher|independent-brancher|execution-verifier|skeptical-evaluator)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/subagent_stop.py"
            ],
            "timeout": 5,
            "statusMessage": "Validating capability result"
          }
        ]
      }
    ]
  }
}
