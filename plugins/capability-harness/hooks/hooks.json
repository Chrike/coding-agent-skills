{
  "description": "Project-scoped decision-first routing and leaf-agent contract checks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit.py"
            ],
            "timeout": 5,
            "statusMessage": "Preparing capability decision"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^capability-harness:(context-scout|evidence-researcher|independent-brancher|execution-verifier|skeptical-evaluator)$",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/subagent_stop.py"
            ],
            "timeout": 5,
            "statusMessage": "Validating capability result"
          }
        ]
      }
    ]
  }
}
